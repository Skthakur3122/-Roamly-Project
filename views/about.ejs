
<% layout("/layouts/boilerplate") %>

<div class="about-page">

    <div class="about-container">

        <!-- Main Heading -->
        <div class="about-header">
            <h1>About Roamly</h1>
            <p>
                Discover places. Create experiences. Travel your way.
            </p>
        </div>

        <hr>

        <!-- About -->
        <div class="about-section">
            <h2>What is Roamly?</h2>
            <p>
                Roamly is a platform designed to make discovering and sharing
                unique places easier. Whether you're looking for a comfortable
                stay for your next trip or want to share your own property,
                Roamly connects travelers with places worth exploring.
            </p>
        </div>

        <!-- Mission -->
        <div class="about-section">
            <h2>Our Mission</h2>
            <p>
                Our goal is to create a simple and user-friendly platform where
                people can discover new destinations, find suitable stays, and
                share their own listings with other travelers.
            </p>
        </div>

        <!-- Features -->
        <div class="about-section">
            <h2>What You Can Do</h2>

            <div class="about-features">

                <div class="feature-box">
                    <h4>Explore Places</h4>
                    <p>
                        Browse different listings and discover places for your
                        next adventure.
                    </p>
                </div>

                <div class="feature-box">
                    <h4>Create Listings</h4>
                    <p>
                        Have a great place to share? Create your own listing
                        and showcase it to travelers.
                    </p>
                </div>

                <div class="feature-box">
                    <h4>Share Reviews</h4>
                    <p>
                        Share your experience and help other travelers make
                        better decisions.
                    </p>
                </div>

            </div>
        </div>

        <!-- Why Roamly -->
        <div class="about-section">
            <h2>Why Roamly?</h2>
            <p>
                Roamly focuses on keeping the travel experience simple.
                From discovering a place to sharing your experience,
                everything is designed to be easy to use and enjoyable.
            </p>
        </div>

        <!-- CTA -->
        <div class="about-cta">
            <h3>Ready to explore?</h3>
            <p>Find your next destination with Roamly.</p>

            <a href="/listings" class="btn btn-primary">
                Explore Listings
            </a>
        </div>

    </div>

</div>

